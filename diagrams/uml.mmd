classDiagram
    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +date due_date
        +bool completed
        +str pet_name
        +mark_complete() Task
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task)
        +remove_task(task)
    }

    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet)
        +get_pet(name) Pet
        +get_all_tasks() List~Task~
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() List~Task~
        +sort_by_time(tasks) List~Task~
        +sort_by_priority(tasks) List~Task~
        +filter_tasks(pet_name, completed) List~Task~
        +todays_schedule(today) List~Task~
        +mark_task_complete(task) Task
        +detect_conflicts() List~str~
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" o-- "*" Task : has
    Scheduler --> Owner : reads tasks via
